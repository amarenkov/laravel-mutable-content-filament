{
    "name": "amarenkov/laravel-mutable-content-filament",
    "description": "Filament 5 admin panel for laravel-mutable-content: forms and tables built from field definitions, screens to manage fields and lists of values, change log authorship.",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "eloquent",
        "jsonb",
        "dynamic-fields",
        "custom-fields",
        "admin",
        "filament-plugin"
    ],
    "homepage": "https://github.com/amarenkov/laravel-mutable-content-filament",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexey Marenkov",
            "email": "alex@marenkov.dev",
            "homepage": "https://github.com/amarenkov"
        }
    ],
    "support": {
        "issues": "https://github.com/amarenkov/laravel-mutable-content-filament/issues",
        "source": "https://github.com/amarenkov/laravel-mutable-content-filament"
    },
    "require": {
        "php": "^8.4",
        "amarenkov/laravel-mutable-content": "^0.6",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Amarenkov\\MutableContentFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amarenkov\\MutableContentFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amarenkov\\MutableContentFilament\\MutableContentFilamentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "larastan/larastan": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
